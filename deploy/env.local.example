# Copy to deploy/env.local on each machine (never commit it).
# The SAME DJANGO_SECRET_KEY must be on the laptop and the tablet.
DJANGO_SECRET_KEY=change-me
YABAI_ORIGIN_SECRET=the-same-value-as-wrangler-secret-ORIGIN_SECRET

# Accounts database: a local SQLite file per machine, kept in step by
# accounts/replication.py (the machine that took writes last is the truth; a machine
# that was away downloads the other's copy before it serves). Set these on BOTH
# machines; PEER_URL is the OTHER machine. Use Tailscale addresses.
# YABAI_REPL_PEER_URL=http://100.x.y.z:8765
# YABAI_REPL_SECRET=      # 16+ chars, identical on both: openssl rand -hex 24
# YABAI_REPL_BIND=0.0.0.0 # or this machine's Tailscale IP; default 127.0.0.1
# YABAI_REPL_PORT=8765
# YABAI_REPL_PRIORITY=laptop   # wins an exact tie after a split brain
# YABAI_REPL_INTERVAL=10       # seconds between checks
# YABAI_REPL_WAIT=30           # seconds a booting machine waits for its peer
#
# Alternative without replication: one shared Postgres for both machines:
# DJANGO_DB_ENGINE=postgres
# DJANGO_DB_NAME=yabai
# DJANGO_DB_USER=yabai
# DJANGO_DB_PASSWORD=...
# DJANGO_DB_HOST=...
#
# Optional: keep logins in the signed cookie instead of the database.
# DJANGO_SESSIONS=cookies

# YABAI_SIGNUPS_OPEN=0      # close registration
# DJANGO_ADMIN_PATH=some-secret-path/   # move the admin site off /admin/
# YABAI_DEBUG_TOKEN=...     # lets you read /__debug/status without logging in
