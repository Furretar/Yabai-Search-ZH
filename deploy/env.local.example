# Copy to deploy/env.local on each machine (never commit it).
# The SAME DJANGO_SECRET_KEY must be on the laptop and the tablet.
DJANGO_SECRET_KEY=change-me
YABAI_ORIGIN_SECRET=the-same-value-as-wrangler-secret-ORIGIN_SECRET

# Name shown in the hamburger menu. Defaults to the role passed to run.sh.
# YABAI_SERVED_BY="galaxy tab s2"

# Bind address: 127.0.0.1 behind a tunnel; 0.0.0.0 to reach the app directly
# over the LAN or Tailscale.
# YABAI_BIND=0.0.0.0

# Host names Django accepts when the app is reached directly.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.50.135

# Accounts database: a local SQLite file per host. Only the global writer (chosen by
# the Cloudflare Worker, see deploy/GLOBAL-WRITER.md) changes it; every other host
# copies the writer's file every 10 seconds through its tunnel. Set these on EVERY
# host. No Tailscale and no peer list: hosts learn who the writer is from the Worker.
# YABAI_CONTROL_URL=https://yabaisearch.org/__control/state
# YABAI_REPL_SECRET=      # 16+ chars, identical on all hosts AND the Worker's
#                         # REPL_SECRET: openssl rand -hex 24
# YABAI_REPL_PORT=8765    # cloudflared sends /__repl/ here (deploy/cloudflared/*.yml)
# YABAI_REPL_INTERVAL=10  # seconds between pulls
# YABAI_REPL_WAIT=30      # seconds a booting host waits for the Worker and the writer
#
# Alternative without replication: one shared Postgres for both machines:
# DJANGO_DB_ENGINE=postgres
# DJANGO_DB_NAME=yabai
# DJANGO_DB_USER=yabai
# DJANGO_DB_PASSWORD=...
# DJANGO_DB_HOST=...
#
# Optional: keep logins in the signed cookie instead of the database.
# (Sessions are signed cookies by default when YABAI_CONTROL_URL is used.)
# DJANGO_SESSIONS=cookies

# YABAI_SIGNUPS_OPEN=0      # close registration
# DJANGO_ADMIN_PATH=some-secret-path/   # move the admin site off /admin/
# YABAI_DEBUG_TOKEN=...     # lets you read /__debug/status without logging in
